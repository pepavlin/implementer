{
    "name": "implementer",
    "version": "1.0.0",
    "description": "AI Code Task Execution Service - receives coding tasks via REST API, executes them using Claude Code CLI",
    "type": "module",
    "scripts": {
        "dev": "tsx src/index.ts",
        "dev:frontend": "vite src/frontend",
        "build": "tsc && vite build src/frontend",
        "build:backend": "tsc",
        "build:frontend": "vite build src/frontend",
        "start": "node dist/index.js",
        "check": "tsx src/check-config.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "express": "^4.21.0",
        "js-yaml": "^4.1.0",
        "nanoid": "^5.0.9",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "swagger-ui-express": "^5.0.1",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.10.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "@vitejs/plugin-react": "^5.1.4",
        "supertest": "^7.2.2",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    }
}
