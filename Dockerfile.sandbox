FROM node:22

# Docker Engine (daemon + CLI) for true Docker-in-Docker inside the sandbox
COPY --from=docker:27-dind /usr/local/bin/dockerd          /usr/local/bin/dockerd
COPY --from=docker:27-dind /usr/local/bin/docker            /usr/local/bin/docker
COPY --from=docker:27-dind /usr/local/bin/containerd        /usr/local/bin/containerd
COPY --from=docker:27-dind /usr/local/bin/containerd-shim-runc-v2 /usr/local/bin/containerd-shim-runc-v2
COPY --from=docker:27-dind /usr/local/bin/runc              /usr/local/bin/runc

# gosu for dropping privileges; iptables for Docker container networking
RUN apt-get update && apt-get install -y --no-install-recommends gosu iptables \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code

# Install Playwright system deps and browser (needs root)
# Disable HTTP pipelining to work around CDN hash mismatch issues
RUN echo 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99fixhash \
    && echo 'Acquire::http::No-Cache "True";' >> /etc/apt/apt.conf.d/99fixhash \
    && apt-get clean && apt-get update \
    && apt-get install -y --no-install-recommends \
       libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 \
       libcups2 libdbus-1-3 libdrm2 libgbm1 libnspr4 libnss3 \
       libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxrandr2 \
       xvfb fonts-noto-color-emoji fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN npx -y @playwright/mcp@latest --help > /dev/null 2>&1 || true \
    && npx playwright install --with-deps chromium \
    && chmod -R 777 /opt/pw-browsers

# Replace the default node user (uid 1000) with claude at the same uid
RUN userdel -r node && useradd -m -s /bin/bash -u 1000 claude

# Add claude to the docker group so it can use the nested Docker daemon
RUN groupadd -f docker && usermod -aG docker claude

# Git identity and config for commits inside the container (as claude user)
RUN gosu claude git config --global user.name "Implementer" && \
    gosu claude git config --global user.email "implementer@noreply" && \
    gosu claude bash -c 'echo "._*" > ~/.gitignore_global' && \
    gosu claude git config --global core.excludesFile /home/claude/.gitignore_global

WORKDIR /home/claude

# Install gh-pr-guard: a Claude Code PreToolUse hook that blocks destructive PR operations.
# This is a hard technical enforcement (on top of the system-prompt instruction) so that
# even if Claude ignores the instruction it still cannot run `gh pr close/merge/delete`.
COPY gh-pr-guard.sh /usr/local/bin/gh-pr-guard
RUN chmod +x /usr/local/bin/gh-pr-guard

# Entrypoint starts dockerd, waits for it, then runs claude as unprivileged user
COPY sandbox-entrypoint.sh /usr/local/bin/sandbox-entrypoint.sh
RUN chmod +x /usr/local/bin/sandbox-entrypoint.sh

ENTRYPOINT ["sandbox-entrypoint.sh"]
